# Copy to .env and fill in. Never commit .env.

# Discord bot token (Discord Developer Portal → your app → Bot → Reset Token). Not needed for --console.
DISCORD_BOT_TOKEN=

# Leave EMPTY. A `claude setup-token` token is inference-only: the claude.ai connectors don't connect
# (verified 2026-11-18). Use the stored `claude` login instead. ANTHROPIC_API_KEY also drops the connectors.
CLAUDE_CODE_OAUTH_TOKEN=

# Comma-separated numeric Discord user ids allowed to talk to the bot anywhere (Discord: Settings → Advanced →
# Developer Mode, then right-click your name → Copy User ID). Everyone else is ignored. Not needed for --console.
ALLOWED_USER_IDS=

# Comma-separated numeric ids of forum channels whose posts are full private conversations (one post = one
# session, no @mention needed). Right-click the forum → Copy Channel ID. Make the forum private to you + the bot.
# Empty = forum mode off.
FORUM_CHANNEL_IDS=

# Comma-separated numeric ids of servers where the bot answers an @mention of it (or a reply to it) outside the
# forums. Right-click the server icon → Copy Server ID. Other servers are ignored. Empty = channel mentions off.
# A mention in a channel opens a thread on that message and the bot answers there; in that thread every message
# from an ALLOWED_USER_IDS author reaches it, no mention needed. Each thread is its own conversation.
#  - Channel only you (+ bots) can see (@everyone can't view it, every human who can is in ALLOWED_USER_IDS):
#    full PRIVATE answer, same tools and approvals as a DM. Checked on every message; fails closed to public.
#  - Any other channel: PUBLIC answer, web search/fetch only, no calendar, to-dos, notes or memory.
# Needs Server Members Intent (Developer Portal → your app → Bot); without it the bot exits with code 2.
# Bot permissions there: Create Public Threads and Send Messages in Threads (plus View Channels, Send Messages).
ALLOWED_GUILD_IDS=

# The assistant's name, injected into its system prompt. Renaming = change this + the Discord portal name.
ASSISTANT_NAME=Nethor

# IANA time zone for reminders, the 04:00 session rollover and "back at HH:MM" messages.
ASSISTANT_TZ=Europe/Oslo

# Google Calendar id of the dedicated "Assistant" calendar (Google Calendar → calendar settings →
# Integrate calendar → Calendar ID, looks like ...@group.calendar.google.com). Events here are auto-approved.
ASSISTANT_CALENDAR_ID=

# Notion page ids (32 hex chars from the page URL) of the "Assistant" page and its child "Sessions" page.
NOTION_ASSISTANT_PAGE_ID=
NOTION_SESSIONS_PAGE_ID=

# Notion page id of the "Memory" page (a child of "Assistant") with the headings About me, People, Preferences,
# Routines & places, Projects & goals, Other. Fetched at every new private session and edited in place (auto-approved).
# Empty = memory off (startup WARNING): nothing is loaded or saved.
NOTION_MEMORY_PAGE_ID=

# Claude model id.
ASSISTANT_MODEL=claude-sonnet-5-5
